# 测试用例管理平台登录账号
CASE_API_USERNAME=wangzhaochen

# 测试用例管理平台登录密码
CASE_API_PASSWORD=

# 测试用例管理平台 API 基础地址
CASE_API_BASE_URL=http://192.168.26.181:10094/

# 文本向量化服务地址，用于健康检查和 embedding 生成
CASE_SEMANTIC_EMBED_URL=http://192.168.26.181:18001

# Qdrant 向量数据库地址
CASE_QDRANT_URL=http://192.168.26.181:16333

# Qdrant 中存放测试项目语义索引的 collection 名称
CASE_QDRANT_COLLECTION=test_project_semantics

# 向量检索时用于过滤测试项目数据的 project_id
CASE_VECTOR_PROJECT_ID=l4-software

# 向量检索最低相似度阈值，低于该分数的结果会被过滤
CASE_VECTOR_SCORE_THRESHOLD=0.55

# 默认语义召回上限；命令传入 --size 时优先使用 --size
CASE_VECTOR_DEFAULT_LIMIT=50
